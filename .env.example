# --- Общее ---
# dev | prod
ENV=dev
TZ=Europe/Moscow

# --- Telegram ---
BOT_TOKEN=
# числовой ID владельца: владельческие команды
OWNER_TELEGRAM_ID=
# куда слать уведомления и алерты (обычно = OWNER_TELEGRAM_ID)
OWNER_CHAT_ID=
OWNER_USERNAME=vegorovmsk
OWNER_FULL_NAME=Владимир Егоров
# например socks5://user:pass@host:1080; пусто — без прокси
TELEGRAM_PROXY=

# --- Данные ---
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
DATA_RETENTION_DAYS=180
ABANDONED_SESSION_DAYS=14
CONSENT_VERSION=2026-10-23
PRIVACY_POLICY_URL=
# случайная строка для хеша в audit_log
AUDIT_HASH_SALT=

# --- Лимиты ---
RATE_LIMIT_PER_MINUTE=20
MAX_BRIEFS_PER_USER_PER_DAY=3
MAX_REVISIONS=3

# --- LLM ---
# начальное значение; /llm on|off владельца хранится в БД и сильнее
LLM_ENABLED=true
# yandex | openrouter | fake
LLM_PROVIDER=yandex
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
# folder_id каталога Yandex Cloud
LLM_PROJECT=
LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# пусто — как LLM_MODEL
LLM_MODEL_ESTIMATE=
# только eval
LLM_JUDGE_BASE_URL=https://openrouter.ai/api/v1
LLM_JUDGE_API_KEY=
LLM_JUDGE_MODEL=
# по актуальному прайсу
LLM_PRICE_PER_1K_INPUT_RUB=
LLM_PRICE_PER_1K_OUTPUT_RUB=
LLM_DAILY_BUDGET_RUB=300
LLM_PROXY=

# --- Google ---
GDRIVE_ENABLED=false
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GSHEETS_ENABLED=false
GSHEETS_SA_KEY_PATH=secrets/gsheets-sa.json
GSHEET_ID=
GSHEET_WORKSHEET=Брифы
SHEETS_INCLUDE_CONTACTS=false

# --- Яндекс Диск ---
YADISK_ENABLED=false
YADISK_OAUTH_TOKEN=
YADISK_BASE_PATH=app:/briefs
CLOUD_FILE_TTL_DAYS=30

# --- Почта ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
# пароль приложения
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_PER_BRIEF_LIMIT=2
EMAIL_PER_USER_DAILY_LIMIT=3
EMAIL_DAILY_LIMIT=50

# --- VK (этап 6) ---
VK_ENABLED=false
VK_GROUP_ID=
VK_GROUP_TOKEN=
